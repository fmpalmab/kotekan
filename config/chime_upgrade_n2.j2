# 390625 is the number of F-engine time samples per second. e.g. 1/2.56us. 
# this is really frame_arrival_rate (the inverse of period)
frame_arrival_period: 390625/samples_per_frame

run_send_pl_mask:
    gpu_0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        in_buffers:
            host_pl_mask_buffer: host_pl_mask_buffer
        out_buffers:
            host_pl_mask_ringbuffer: host_pl_mask_ringbuffer
        commands:
        - name: cudaCopyToRingbuffer
          input_size: (64 / 8) * (num_dishes / 8) * num_polarizations * (num_frequencies / 4) * (num_times / 2 / 64)
          ring_buffer_size: buffer_depth * input_size
          in_buf: host_pl_mask_buffer
          signal_buf: host_pl_mask_ringbuffer
          gpu_mem_output: pl_mask_buffer

run_expand_pl_mask:
    gpu_0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        in_buffers:
            host_pl_mask_ringbuffer: host_pl_mask_ringbuffer
        out_buffers:
            host_pl_expanded_mask_ringbuffer: host_pl_expanded_mask_ringbuffer
        commands:
        - name: cudaPLMaskExpander
          pl_mask_name: pl_mask
          pl_expanded_mask_name: pl_expanded_mask

run_send_voltage:
    gpu_0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        in_buffers:
            # host_voltage_buffer: host_voltage_buffer
            {%- for id in range(16) %} # num_frequencies = 16
            host_voltage_buffer_{{ id }}: host_voltage_buffer_{{ id }}
            {%- endfor %}
        out_buffers:
            host_voltage_ringbuffer: host_voltage_ringbuffer
        commands:
        - name: cudaCopyNToRingbuffer
          ring_buffer_size: buffer_depth * input_size
          in_bufs: 
            {%- for id in range(16) %} # num_frequencies = 16
            - host_voltage_buffer_{{ id }}
            {%- endfor %}
          signal_buf: host_voltage_ringbuffer
          gpu_mem_output: voltage_buffer

# glue code to handle lost frames formats
lostSamplesToPLMask:
    kotekan_stage: lostSamplesToPLMask
    pl_mask_buf: host_pl_mask_buffer
    lost_samples_buffers:
      - lost_samples_buffer_0
      - lost_samples_buffer_1
      - lost_samples_buffer_2
      - lost_samples_buffer_3

# data is set by FEngine from an explicit list in the yaml file, then output as
# a buffer
kludge_constant_buffers:
    input_dir: data/fengine_init_chime
    prefix_hostname: false
    prefix_host_rank: true
    read_bf_mask:
        do_once: true
        kotekan_stage: hdf5FileRead
        file_name: bf_mask
        out_buf: host_bf_mask_buffer

