vis_accumulate:
    kotekan_stage: N2AccumulateCHIME
    in_buf: host_n2k_correlation_buffer
    in_counts_buf: host_n2k_counts_buffer
    in_rfimask_buf: host_rfi_RFImask_buffer
    out_buf: vis_5s_buffer
    packet_loss_is_scalar: True
    # TODO: this should use a ceil or similar, NB: frame_arrival_period is really frame_arrive_rate
    num_n2k_samples_to_accumulate: (5 * frame_arrival_period * n2k_num_subintegrations)/2 * 2
    # these recap values from cudaCorrelator
    num_freq_per_n2k_frame: num_frequencies
    samples_per_data_set: n2k_samples_per_data_set
    sub_integration_ntime: n2k_sub_integration_ntime
    # set as global variable of same name
    #rfi_downsampling_factor: rfi_downsampling_factor
    num_elements: n2k_correlation_num_elements
    num_ev: 0 # only allowed, whatever it may be...

