vis_accumulate:
    kotekan_stage: N2Accumulate
    in_buf: host_n2k_correlation_buffer
    in_counts_buf: host_n2k_counts_buffer
    in_rfimask_buf: host_rfi_RFImask_buffer
    out_buf: vis_10s_buffer
    packet_loss_is_scalar: True
    num_threads: 3
    # round_to_even(10 / ( n2k_samples_per_data_set * frame_arrival_period ) * n2k_num_subintegrations)
    # round_to_even(10s / ( 16384 * 2.56us ) * 1) = 238
    num_n2k_samples_to_accumulate: 238
    # these recap values from cudaCorrelator
    num_freq_per_n2k_frame: num_frequencies
    samples_per_data_set: n2k_samples_per_data_set
    sub_integration_ntime: n2k_sub_integration_ntime
    # set as global variable of same name
    #rfi_downsampling_factor: rfi_downsampling_factor
    num_elements: n2k_correlation_num_elements
    num_ev: 0 # only allowed, whatever it may be...

eigencalc:
    kotekan_stage: EigenN2Iter
    num_ev: num_ev_to_calculate
    in_buf: vis_10s_buffer
    out_buf: eig_10s_buffer
    failed_buf: failed_10s_buffer
    # Convergence config from chime science run
    tol_eval: 0.00001
    tol_evec: 0.0001
    max_iterations: 19
    num_ev_conv: 2
    krylov: 2
    subspace: 1

vis_pool:
    kotekan_metadata_pool: VisMetadata
    num_metadata_objects: num_freq_gpu_buf * buffer_depth # same as n2_pool

vis_buffer:
    kotekan_buffer: vis
    metadata_pool: vis_pool
    num_frames: buffer_depth * num_frequencies

failed_vis_buffer:
    kotekan_buffer: vis
    metadata_pool: vis_pool
    num_frames: buffer_depth * num_frequencies

vis_convert:
    kotekan_stage: n2FrameToVisFrame
    n2_buf: eig_10s_buffer
    vis_buf: vis_buffer

failed_vis_convert:
    kotekan_stage: n2FrameToVisFrame
    n2_buf: failed_10s_buffer
    vis_buf: failed_vis_buffer

write_vis:
    kotekan_stage: VisWriter
    root_path: vis_data
    file_type: raw
    in_buf: vis_buffer

write_failed_vis:
    kotekan_stage: VisWriter
    root_path: failed_eig
    file_type: raw
    in_buf: failed_vis_buffer
